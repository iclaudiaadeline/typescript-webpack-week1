{
  "compilerOptions": {
    "target": "es5",           // Compile TypeScript down to ES5 JavaScript (works in older browsers)
    "module": "commonjs",      // Use CommonJS module system (Node.js style require/exports)
    "outDir": "./dist",        // Output compiled JS files to the dist folder
    "rootDir": "./src",        // Look for TypeScript source files in the src folder
    "strict": true,            // Enable all strict type-checking rules
    "esModuleInterop": true,   // Allows default imports from CommonJS modules
    "skipLibCheck": true,      // Skip type checking of declaration files (faster builds)
    "forceConsistentCasingInFileNames": true,  // Prevent import casing issues across OS
    "moduleResolution": "node" // Resolve modules the same way Node.js does
  },
  "include": ["src/**/*"],     // Only compile files inside the src folder
  "exclude": ["node_modules"]  // Ignore the node_modules folder
}